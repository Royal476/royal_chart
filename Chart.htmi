<!DOCTYPE html>
<html>
<head>
<meta name="viewport" content="width=device-width, initial-scale=1">
<script src="https://s.tradingview.com/tv.js"></script>
<script src="https://html2canvas.hertzen.com/dist/html2canvas.min.js"></script>
<style>body{margin:0; background:#0A0A0A} #tradingview_chart{width:100vw; height:100vh}</style>
</head>
<body>
<div id="tradingview_chart"></div>

<script>
// YOUR LIVE TRADINGVIEW WIDGET
var widget = new TradingView.widget({
  "autosize": true,
  "symbol": "OANDA:XAUUSD",
  "interval": "15",
  "timezone": "Etc/UTC",
  "theme": "dark",
  "style": "1",
  "locale": "en",
  "enable_publishing": false,
  "allow_symbol_change": true,
  "container_id": "tradingview_chart"
});

// THE SECRET - INTERNAL CAPTURE, NO BLACK SCREEN
function captureChartForGemini() {
  return html2canvas(document.getElementById('tradingview_chart')).then(canvas => {
    return canvas.toDataURL('image/png'); // returns base64
  });
}

function changeSymbol(newSym){
  widget.chart().setSymbol(newSym);
}
</script>
</body>
</html>
