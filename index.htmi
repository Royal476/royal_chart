<!DOCTYPE html><html><head><meta name="viewport" content="width=device-width,initial-scale=1"><script src="https://unpkg.com/lightweight-charts@4.1.0/dist/lightweight-charts.standalone.production.js"></script><style>body{margin:0;background:#0A0A0A}#chart{width:100vw;height:100vh}</style></head><body><div id="chart"></div><script>const chart=LightweightCharts.createChart(document.getElementById('chart'),{layout:{background:{color:'#0A0A0A'},textColor:'#DDD'},grid:{vertLines:{color:'#1A1A1A'},horzLines:{color:'#1A1A1A'}}});const c=chart.addCandlestickSeries({upColor:'#00D2C4',downColor:'#FF4976',borderVisible:false});async function load(){try{let r=await fetch('https://api.binance.com/api/v3/klines?symbol=PAXGUSDT&interval=15m&limit=150');let d=await r.json();let a=d.map(k=>({time:k[0]/1000,open:+k[1],high:+k[2],low:+k[3],close:+k[4]}));c.setData(a);chart.timeScale().fitContent();}catch(e){}}load();setInterval(load,5000);</script></body></html>
